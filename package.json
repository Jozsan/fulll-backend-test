{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "type": "commonjs",
  "main": "index.js",
  "bin": {
    "fleet": "./fleet"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "cli": "node --env-file=.env -r tsx/cjs src/infrastructure/cli/index.ts",
    "dev:services": "docker-compose -f dev.compose.yaml up",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env -r tsx/cjs src/infrastructure/persistence/postgres/migrate.ts",
    "test": "cucumber-js --profile default",
    "test:ut": "tsc --noEmit && vitest",
    "test:critical": "PERSISTENCE=postgres node --env-file=.env -r tsx/cjs node_modules/.bin/cucumber-js --profile critical"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "commander": "^15.1.0",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  }
}
